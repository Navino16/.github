#!/usr/bin/env bash
# Stand-in for `gh api` in tests: reads come from $FAKE_GH_DIR, writes are appended to $FAKE_GH_LOG.
# A write answers with $FAKE_GH_DIR/<METHOD>_<endpoint>.json if present, and fails if fail_<METHOD>_<endpoint> exists.
set -euo pipefail
[ "$1" = api ] || { echo "fake gh: only 'api' is supported" >&2; exit 2; }
shift
method=GET
path=""
input=false
filter=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -X) method="$2"; shift 2 ;;
    --input) input=true; shift 2 ;;
    --jq) filter="$2"; shift 2 ;;
    *) path="$1"; shift ;;
  esac
done
path="${path%%\?*}"
endpoint="${path#repos/*/*/}"
[ "$endpoint" = "$path" ] && endpoint=repo
key="${endpoint//\//_}"
answer() { if [ -n "$filter" ]; then jq -r "$filter" "$1"; else cat "$1"; fi; }
if [ "$method" != GET ]; then
  body=""
  $input && body="$(jq -c . </dev/stdin)"
  echo "$method $endpoint $body" >>"$FAKE_GH_LOG"
  [ ! -e "$FAKE_GH_DIR/fail_${method}_$key" ] || { echo "HTTP 422" >&2; exit 1; }
  [ ! -e "$FAKE_GH_DIR/${method}_$key.json" ] || answer "$FAKE_GH_DIR/${method}_$key.json"
  exit 0
fi
file="$FAKE_GH_DIR/$key.json"
if [ "$endpoint" = vulnerability-alerts ]; then
  [ -e "$file" ] && exit 0 || { echo "HTTP 404" >&2; exit 1; }
fi
[ -e "$file" ] || { echo "HTTP 404" >&2; exit 1; }
answer "$file"
