{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset of Navino16's repositories, see STANDARDS.md",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "labels": [
    "dependencies"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "1 day",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "automergeSchedule": [
    "at any time"
  ],
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ],
    "addLabels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Only patch, digest and pin updates are auto-merged: they land without a reviewer",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "Group npm and bun patch, digest and pin updates",
      "matchManagers": [
        "npm",
        "bun"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "code-dependencies"
    },
    {
      "description": "Group GitHub Actions patch, digest and pin updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "ci-dependencies"
    },
    {
      "description": "Group Docker image patch, digest and pin updates (Dockerfile and compose files)",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "docker-dependencies"
    },
    {
      "description": "Minors wait for a review in one weekly pull request",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "minor-dependencies",
      "automerge": false
    },
    {
      "description": "Move every reference to this kit (workflows and preset) in one pull request, auto-merged only for a patch release",
      "matchPackageNames": [
        "Navino16/.github"
      ],
      "groupName": "repo-kit"
    },
    {
      "description": "Majors are never auto-merged; post-it picks them up through the major label",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ],
      "automerge": false
    }
  ]
}
